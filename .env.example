# Copie para .env (local) ou cadastre na hospedagem. NUNCA faça commit do .env.
# Valores vazios = preencher. Os demais mostram o padrão.

# --- Claude API (use um workspace dedicado e uma chave de service account) ---
ANTHROPIC_API_KEY=
MODELO=claude-haiku-5-5
MAX_TOKENS=500
# low | medium | high | padrao (padrao = não envia o campo). "low" gasta menos raciocínio.
ESFORCO=low
MAX_ITERACOES_FERRAMENTAS=5
HISTORICO_MAX_MENSAGENS=20
HISTORICO_HORAS=24

# --- WhatsApp Cloud API (Meta) ---
# Token permanente do System User (Business Manager > Usuários do sistema)
META_TOKEN=
# ID do número (WhatsApp > Configuração da API), não é o telefone
META_PHONE_NUMBER_ID=
# App Secret (Configurações do app > Básico): valida a assinatura do webhook
META_APP_SECRET=
# Texto que você inventa e repete no cadastro do webhook na Meta
META_VERIFY_TOKEN=
GRAPH_API_VERSAO=v24.0

# --- Negócio e humano no circuito ---
NOME_NEGOCIO=Clínica Exemplo
# WhatsApp do responsável com DDI+DDD, só dígitos (recebe os avisos de transferência)
NUMERO_RESPONSAVEL=
# Opcional: nome do template aprovado na Meta para avisar o responsável ({{1}} telefone, {{2}} motivo)
TEMPLATE_AVISO_RESPONSAVEL=
PAUSA_HUMANO_HORAS=12
HORAS_NOVA_CONVERSA=24
FUSO=America/Sao_Paulo
# dias 0=segunda ... 6=domingo; dias ausentes = fechado
HORARIO_COMERCIAL=0-4=08:00-18:00;5=08:00-12:00
DURACAO_CONSULTA_MIN=30

# --- Guardas ---
LIMITE_GASTO_DIARIO_USD=2.0
LIMITE_MSGS_POR_HORA=30
MAX_CARACTERES_ENTRADA=1500
RETENCAO_DIAS=180

# --- Relatórios ---
CAMBIO_BRL=5.53
META_PRECO_MSG_BRL=0.035
META_FRANQUIA_MSGS=1000

# --- Transcrição de áudio (opcional; só ativa com URL e chave) ---
TRANSCRICAO_URL=
TRANSCRICAO_CHAVE=
TRANSCRICAO_MODELO=whisper-1

# --- Nível 2: documentos (opcional; desligado por padrão) ---
# 1 = foto ou PDF recebido no WhatsApp é baixado, extraído para a planilha e marcado para revisão.
# MODO_DOCUMENTOS=0
# MODELO_DOCUMENTOS=claude-haiku-5-5
# Sonnet só quando o Haiku devolve campos de baixa confiança (roteamento no código). 0 = nunca usa Sonnet.
# MODELO_DOCUMENTOS_AMBIGUO=claude-sonnet-5-5
# ROTEAR_AMBIGUO=1
# Na hospedagem, aponte para o volume persistente, ex.: /data/documentos e /data/planilhas
# DOCUMENTOS_DIR=dados/documentos
# PLANILHAS_DIR=dados/planilhas
# CHECKLIST_DOCUMENTOS=checklist_documentos.yaml

# --- Painel /admin (senha do navegador; gere uma longa e aleatória) ---
ADMIN_TOKEN=

# --- Caminhos (padrão: dentro do projeto) ---
# Na hospedagem, aponte para um volume persistente, ex.: /data/agente.db
# DB_CAMINHO=/data/agente.db
